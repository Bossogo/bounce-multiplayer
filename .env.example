# Port for the WebSocket + static game server (production `pnpm start`)
PORT=3001

# Vite client proxies /api/ws to this during `pnpm dev`
VITE_WS_PORT=3001

# Upstash Redis — set automatically on Vercel via `vercel integration add upstash`
# Required so two browsers can share a room across Fluid Compute instances
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
